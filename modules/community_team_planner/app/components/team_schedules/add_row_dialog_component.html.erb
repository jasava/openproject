<%=
  render(
    Primer::Alpha::Dialog.new(
      title: t("community_team_planner.grid.add_row_button"),
      size: :medium,
      id: DIALOG_ID,
      data: { "keep-open-on-submit": true }
    )
  ) do |d|
    d.with_header(variant: :large)

    d.with_body do
      component_wrapper do
        primer_form_with(
          id: FORM_ID,
          scope: :row,
          method: :post,
          url: add_row_project_team_schedule_path(@project, @team_schedule)
        ) do |f|
          render TeamSchedules::Forms::AddRowForm.new(
            f, project: @project, existing_ids: @team_schedule.assignee_ids, dialog_id: DIALOG_ID
          )
        end
      end
    end

    d.with_footer do
      component_collection do |buttons|
        buttons.with_component(
          Primer::Beta::Button.new(data: { close_dialog_id: DIALOG_ID })
        ) { t(:button_cancel) }

        buttons.with_component(
          Primer::Beta::Button.new(scheme: :primary, form: FORM_ID, data: { turbo: true }, type: :submit)
        ) { t(:button_add) }
      end
    end
  end
%>
