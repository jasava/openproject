<%=
  component_wrapper(
    tag: "div",
    class: ["op-team-schedule-card", ("op-team-schedule-card_milestone" if milestone?), ("op-team-schedule-card_draggable" if draggable?)].compact,
    style: @grid_style,
    role: "gridcell",
    "aria-label": accessible_label,
    tabindex: "0",
    data: {
      controller: draggable? ? "team-schedule--card" : nil,
      "team-schedule--card-url-value": card_url,
      "team-schedule--card-start-date-value": start_date&.iso8601,
      "team-schedule--card-due-date-value": due_date&.iso8601
    }
  ) do
%>
  <% if draggable? %>
    <span class="op-team-schedule-card--resize-handle op-team-schedule-card--resize-handle_start"
          data-team-schedule--card-target="startHandle"
          role="button"
          tabindex="0"
          aria-label="<%= t("community_team_planner.card.resize_start") %>"></span>
  <% end %>

  <%= link_to(
        @work_package.subject, split_view_href,
        class: "op-team-schedule-card--subject",
        data: { "turbo-frame": "content-bodyRight" }
      ) %>

  <% if status_name %>
    <span class="op-team-schedule-card--status"><%= status_name %></span>
  <% end %>

  <% if draggable? %>
    <span class="op-team-schedule-card--resize-handle op-team-schedule-card--resize-handle_end"
          data-team-schedule--card-target="endHandle"
          role="button"
          tabindex="0"
          aria-label="<%= t("community_team_planner.card.resize_end") %>"></span>
  <% end %>
<% end %>
