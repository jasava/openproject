<% html_title(@team_schedule.name) %>

<% content_for :content_body do %>
  <%= render(Primer::OpenProject::PageHeader.new) do |header|
        header.with_title { @team_schedule.name }
        header.with_breadcrumbs(
          [{ href: project_overview_path(@project.id), text: @project.name },
           { href: project_team_schedules_path(@project), text: t("community_team_planner.index.title") },
           @team_schedule.name]
        )

        if @team_schedule.manageable?(User.current)
          header.with_action_menu(
            menu_arguments: { anchor_align: :end },
            button_arguments: { icon: "kebab-horizontal", "aria-label": t(:label_more) }
          ) do |menu|
            menu.with_item(
              label: t(:button_rename), href: edit_project_team_schedule_path(@project, @team_schedule),
              content_arguments: { data: { controller: "async-dialog" } }
            ) do |item|
              item.with_leading_visual_icon(icon: :pencil)
            end
            menu.with_item(
              label: @team_schedule.public? ? t("community_team_planner.action.make_private") : t("community_team_planner.action.make_public"),
              href: toggle_public_project_team_schedule_path(@project, @team_schedule),
              content_arguments: { data: { turbo_method: :post } }
            ) do |item|
              item.with_leading_visual_icon(icon: @team_schedule.public? ? :lock : :globe)
            end
            menu.with_item(
              label: t("community_team_planner.action.delete"), scheme: :danger,
              href: project_team_schedule_path(@project, @team_schedule),
              content_arguments: { data: { turbo_method: :delete, turbo_confirm: t(:text_are_you_sure) } }
            ) do |item|
              item.with_leading_visual_icon(icon: :trash)
            end
          end
        end
      end %>

  <%= render(@grid) %>
<% end %>

<% content_for :content_body_right do %>
  <%= render(split_view_instance) if render_work_package_split_view? %>
<% end %>
