<%=
  render(
    Primer::Alpha::Dialog.new(
      title: t("global_team_planner.grid.add_row_button"),
      size: :medium,
      id: DIALOG_ID,
      data: { "keep-open-on-submit": true }
    )
  ) do |d|
    d.with_header(variant: :large)

    d.with_body do
      component_wrapper do
        tag.div(
          data: {
            controller: "global-team-planner--principal-picker",
            "global-team-planner--principal-picker-candidates-url-value": global_team_planner_principal_candidates_path,
            "global-team-planner--principal-picker-project-ids-value": candidate_project_ids.to_json,
            "global-team-planner--principal-picker-existing-ids-value": @view.assignee_ids.to_json,
            "global-team-planner--principal-picker-no-results-message-value": t("global_team_planner.grid.add_row_no_results"),
            "global-team-planner--principal-picker-remove-label-value": t("global_team_planner.grid.remove_row_button")
          }
        ) do
          safe_join(
            [
              primer_form_with(
                id: FORM_ID,
                scope: :row,
                method: :post,
                url: add_row_global_team_planner_view_path(@view)
              ) do |f|
                render(GlobalTeamPlannerViews::Forms::AddRowForm.new(f))
              end,
              tag.div(
                "",
                class: "op-global-team-planner--principal-picker-selected",
                data: { "global-team-planner--principal-picker-target": "selected" }
              ),
              tag.ul(
                "",
                class: "op-global-team-planner--principal-picker-results",
                data: { "global-team-planner--principal-picker-target": "results" }
              )
            ]
          )
        end
      end
    end

    d.with_footer do
      component_collection do |buttons|
        buttons.with_component(
          Primer::Beta::Button.new(data: { close_dialog_id: DIALOG_ID })
        ) { t(:button_cancel) }

        buttons.with_component(
          Primer::Beta::Button.new(scheme: :primary, form: FORM_ID, data: { turbo: true }, type: :submit)
        ) { t(:button_add) }
      end
    end
  end
%>
