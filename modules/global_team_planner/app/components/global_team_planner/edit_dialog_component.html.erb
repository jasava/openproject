<%=
  render(
    Primer::Alpha::Dialog.new(
      title:,
      size: :large,
      classes: "Overlay--size-large-portrait",
      id: DIALOG_ID,
      data: { "keep-open-on-submit": true }
    )
  ) do |d|
    d.with_header(variant: :large)

    d.with_body do
      render(
        GlobalTeamPlanner::FormComponent.new(
          view: @view,
          current_user: @current_user,
          url: global_team_planner_view_path(@view),
          method: :patch,
          form_id: FORM_ID,
          show_filters: true
        )
      )
    end

    d.with_footer do
      render(
        GlobalTeamPlanner::FooterComponent.new(
          dialog_id: DIALOG_ID,
          form_id: FORM_ID,
          footer_id: FOOTER_ID,
          submit_label: I18n.t("global_team_planner.edit_dialog.submit")
        )
      )
    end
  end
%>
