<% html_title t("global_team_planner.index.title") %>

<%= render(Primer::OpenProject::PageHeader.new) do |header|
      header.with_title { t("global_team_planner.index.title") }
      header.with_breadcrumbs([{ href: global_team_planner_path, text: t(:label_global_team_planner) }, t("global_team_planner.index.title")])
    end %>

<%= render(Primer::OpenProject::SubHeader.new) do |subheader|
      subheader.with_action_button(
        tag: :a,
        href: new_global_team_planner_views_path,
        scheme: :primary,
        leading_icon: :plus,
        label: t("global_team_planner.index.new_button"),
        data: { controller: "async-dialog" }
      ) { t("global_team_planner.index.new_button") }
    end %>

<% if @views.any? %>
  <%= render(GlobalTeamPlannerViews::TableComponent.new(rows: @views)) %>
<% else %>
  <%= render(Primer::Beta::Blankslate.new) do |blankslate|
        blankslate.with_visual_icon(icon: :people)
        blankslate.with_heading(tag: :h2) { t("global_team_planner.index.empty_state.title") }
        blankslate.with_description { t("global_team_planner.index.empty_state.description") }
      end %>
<% end %>
