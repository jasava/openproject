<%#
  Phase "View access": "If the user cannot view work packages in any
  project, show an appropriate empty or forbidden state" — distinct from
  the in-grid "no accessible projects" empty state, which is for a user who
  passed this check but whose *currently selected* scope has nothing in it.
%>
<% html_title t(:label_global_team_planner) %>

<%= render(Primer::Beta::Blankslate.new) do |blankslate|
      blankslate.with_visual_icon(icon: :lock)
      blankslate.with_heading(tag: :h2) { t("global_team_planner.empty_state.no_accessible_projects.title") }
      blankslate.with_description { t("global_team_planner.empty_state.no_accessible_projects.description") }
    end %>
