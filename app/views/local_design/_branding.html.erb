<% %i[logo logo_mobile favicon touch_icon].each do |field| %>
  <%= render partial: "local_design/uploads/image", locals: {
        field:,
        label: t("local_design.branding.#{field}.label"),
        present: @local_design_setting.public_send(field).present?,
        source: @local_design_setting.public_send(field).present? ? local_design_asset_download_path(field) : nil,
        img_class: "local-design-#{field.to_s.dasherize}-preview",
        accept: "image/png,image/jpeg,image/gif,image/webp",
        instructions: t("local_design.branding.#{field}.instructions")
      } %>
<% end %>
