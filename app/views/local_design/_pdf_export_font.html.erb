<%#
  Phase 16. The regular cut is required before any custom font is applied
  to exports (LocalDesign::PdfBranding.custom_font_active?) — uploading only
  bold/italic/bold-italic with no regular cut leaves PDF exports on the
  default OpenProject font, matching the task's explicit requirement.
%>
<p class="form--field-instructions"><%= t("local_design.pdf_export.fonts.legend_instructions") %></p>

<%=
  render(
    Primer::Beta::Button.new(
      target: "_blank",
      data: { turbo: false },
      tag: :a,
      href: export_demo_pdf_download_local_design_path
    )
  ) { t("export.demo.button_text") }
%>

<% local_design_pdf_font_fields.each do |font| %>
  <%= render partial: "local_design/uploads/font", locals: font %>
<% end %>
